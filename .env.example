# ─────────────────────────────────────────────────────────────────────────────
# AI Economics — environment configuration
# Copy to .env.local (Next.js) and fill in only what you need.
# The public portal works with NONE of these set.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL used in the RSS feed (optional; defaults to the request origin)
PUBLIC_SITE_URL=

# ── Database (private telemetry) ─────────────────────────────────────────────
# Unset → embedded PGlite (Postgres in WASM) under .data/pglite. No Docker needed.
# Set   → PostgreSQL, e.g. docker compose (see docker-compose.yml) or a hosted DB:
# DATABASE_URL=postgres://aie:aie@localhost:5432/aie
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# ── Private monitoring area (/monitoring/live) ──────────────────────────────
# Both required to enable sign-in. SESSION_SECRET must be >= 32 characters.
# PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
ADMIN_TOKEN=
SESSION_SECRET=

# ── OpenTelemetry GenAI ingestion (POST /api/ingest/otlp/v1/traces) ─────────
# Bearer token required by the OTLP endpoint. Unset → endpoint disabled (503).
INGEST_TOKEN=

# ── Telemetry sources (read-only) ───────────────────────────────────────────
# Prometheus HTTP API base URL (only GET /api/v1/query is used)
PROMETHEUS_URL=
PROMETHEUS_BEARER_TOKEN=
# Direct scrape of a vLLM server's /metrics endpoint
VLLM_METRICS_URL=
# Direct scrape of NVIDIA dcgm-exporter (default port 9400)
DCGM_EXPORTER_URL=
# MLflow Tracking server (REST API)
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_TOKEN=
# Live view polling interval in seconds (5–300, default 15)
TELEMETRY_POLL_SECONDS=15

# ── Optional data sources ───────────────────────────────────────────────────
# Raises GitHub API rate limits for `npm run backfill:litellm`
GITHUB_TOKEN=
# Artificial Analysis benchmark feed — requires a licence; adapter not active
# without a key and accepted terms.
ARTIFICIAL_ANALYSIS_API_KEY=

# Override the public dataset directory (default ./data)
# AIE_DATA_DIR=
